{
  "name": "game-demo-develop",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 senado/tests/*.test.mjs test/*.test.mjs",
    "test:game": "node --test --test-concurrency=1 test/game/*.test.mjs",
    "test:all": "npm test && npm run test:game",
    "build": "node scripts/build-single.mjs",
    "itch": "node scripts/itch.mjs",
    "itch:cover": "node scripts/itch-cover.mjs",
    "assets": "node scripts/assets.mjs",
    "assets:docs": "node scripts/asset-docs.mjs",
    "senado:data": "python3 senado/scripts/build_data.py",
    "senado:glb": "node senado/scripts/export_glb.mjs",
    "senado:serve": "python3 -m http.server 8000 --directory senado"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5"
  }
}
